# ── BizKhata backend environment ──
NODE_ENV=development
PORT=4000

# MySQL (matches docker-compose service "db")
DATABASE_URL="mysql://bizkhata:bizkhata_pw@localhost:3306/bizkhata"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS (comma separated origins; * for dev)
CORS_ORIGINS=*

# Email (Gmail SMTP) — used for OTP verification emails.
# SMTP_PASS is a Gmail "App Password" (myaccount.google.com/apppasswords),
# not your real Gmail password. Leave unset to just log OTP emails in dev.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Cloud API — used for party welcome + sale confirmation messages.
# Leave unset to just log WhatsApp messages in dev. Ignored if TWILIO_* below is set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio WhatsApp — takes priority over the WhatsApp Cloud API above when set.
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are on your console.twilio.com dashboard.
# TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender (sandbox: 14155238886).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Publicly reachable base URL of this API (no trailing slash), used to verify
# Twilio's webhook signature. In Twilio console > WhatsApp Sender, set the
# "When a message comes in" webhook to `${PUBLIC_BASE_URL}/api/webhooks/twilio/whatsapp`.
# In dev, expose your local server first (e.g. `ngrok http 4000`) and use that URL.
PUBLIC_BASE_URL=
