# ── BizKhata backend environment ──
NODE_ENV=development
PORT=4000

# MySQL (matches docker-compose service "db")
DATABASE_URL="mysql://bizkhata:bizkhata_pw@localhost:3306/bizkhata"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS (comma separated origins; * for dev)
CORS_ORIGINS=*
