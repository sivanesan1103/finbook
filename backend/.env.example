# ── BizKhata backend environment ──
NODE_ENV=development
PORT=4000

# MySQL (matches docker-compose service "db")
DATABASE_URL="mysql://bizkhata:bizkhata_pw@localhost:3306/bizkhata"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS (comma separated origins; * for dev)
CORS_ORIGINS=*

# Twilio SMS — used for party welcome, sale confirmation, and reminder messages.
# TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are on your console.twilio.com dashboard.
# TWILIO_SMS_FROM is your Twilio SMS sender number.
# Leave unset to just log SMS messages in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
