// BizKhata database schema — MySQL via Prisma
// Conventions: every table carries audit fields (createdAt/updatedAt) and
// soft delete (deletedAt). Money is DECIMAL(12,2). All FKs are indexed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Auth & users ───────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  USER
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  role         UserRole  @default(USER)
  avatarUrl    String?
  language     String    @default("en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  ownedBusinesses Business[]       @relation("BusinessOwner")
  memberships     BusinessMember[]
  transactions    Transaction[]    @relation("TransactionCreator")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────── Businesses ───────────────────────────────

enum MemberRole {
  OWNER
  PARTNER
  STAFF
}

model Business {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  phone     String?
  email     String?
  address   String?   @db.Text
  gstin     String?
  category  String?
  logoUrl   String?
  currency  String    @default("INR")

  // Invoice & payment details printed on tax invoices
  upiId           String?
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  invoiceTerms    String? @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner        User             @relation("BusinessOwner", fields: [ownerId], references: [id])
  members      BusinessMember[]
  parties      Party[]
  transactions Transaction[]
  cashEntries  CashbookEntry[]
  expenses     Expense[]
  expenseItems ExpenseItem[]
  items        Item[]
  invoices     Invoice[]
  reminders    Reminder[]
  activityLogs ActivityLog[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMember {
  id          String     @id @default(cuid())
  businessId  String
  userId      String
  role        MemberRole @default(STAFF)
  permissions Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// ─────────────────────────────── Parties (khata) ───────────────────────────────

enum PartyType {
  CUSTOMER
  SUPPLIER
}

model Party {
  id           String    @id @default(cuid())
  businessId   String
  type         PartyType @default(CUSTOMER)
  name         String
  phone        String?
  email        String?
  gstin        String?
  photoUrl     String?
  addressLine  String?
  area         String?
  city         String?
  state        String?
  pincode      String?
  smsEnabled   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  invoices     Invoice[]
  reminders    Reminder[]

  @@index([businessId, type])
  @@index([businessId, name])
  @@map("parties")
}

// ─────────────────────────────── Ledger transactions ───────────────────────────────

enum TxType {
  GAVE
  GOT
}

enum PaymentMode {
  CASH
  ONLINE
  CHEQUE
  UPI
  BANK
}

model Transaction {
  id          String      @id @default(cuid())
  businessId  String
  partyId     String
  createdById String?
  type        TxType
  amount      Decimal     @db.Decimal(12, 2)
  description String?     @db.Text
  billImage   String?
  paymentMode PaymentMode @default(CASH)
  entryDate   DateTime    @default(now())
  smsSent     Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party         Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("TransactionCreator", fields: [createdById], references: [id])
  cashbookEntry CashbookEntry?

  @@index([businessId, entryDate])
  @@index([partyId, entryDate])
  @@map("transactions")
}

// ─────────────────────────────── Cashbook ───────────────────────────────

enum CashDirection {
  IN
  OUT
}

model CashbookEntry {
  id            String        @id @default(cuid())
  businessId    String
  transactionId String?       @unique
  expenseId     String?       @unique
  direction     CashDirection
  amount        Decimal       @db.Decimal(12, 2)
  paymentMode   PaymentMode   @default(CASH)
  description   String?       @db.Text
  entryDate     DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  expense     Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([businessId, entryDate])
  @@map("cashbook_entries")
}

// ─────────────────────────────── Expenses ───────────────────────────────

model Expense {
  id         String      @id @default(cuid())
  businessId String
  category   String      @default("General")
  amount     Decimal     @db.Decimal(12, 2)
  notes      String?     @db.Text
  attachment String?
  paymentMode PaymentMode @default(CASH)
  entryDate  DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashbookEntry CashbookEntry?

  @@index([businessId, entryDate])
  @@index([businessId, category])
  @@map("expenses")
}

/// Reusable expense item (Khatabook-style): name + default price, per book.
/// Expense items do not affect inventory.
model ExpenseItem {
  id         String    @id @default(cuid())
  businessId String
  name       String
  price      Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, name])
  @@map("expense_items")
}

// ─────────────────────────────── Inventory ───────────────────────────────

model Item {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  sku           String?
  unit          String    @default("PCS")
  salePrice     Decimal   @db.Decimal(12, 2)
  purchasePrice Decimal?  @db.Decimal(12, 2)
  taxRate       Decimal   @default(0) @db.Decimal(5, 2)
  stockQty      Decimal   @default(0) @db.Decimal(12, 3)
  lowStockAlert Decimal?  @db.Decimal(12, 3)
  imageUrl      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  invoiceItems InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("items")
}

enum StockMoveType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  type      StockMoveType
  qty       Decimal       @db.Decimal(12, 3)
  note      String?
  createdAt DateTime      @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("stock_movements")
}

// ─────────────────────────────── Billing / invoices ───────────────────────────────

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
  OPEN      // proforma: awaiting acceptance
  CONVERTED // proforma: turned into a tax invoice
}

enum InvoiceDocType {
  INVOICE
  PROFORMA
}

model Invoice {
  id            String         @id @default(cuid())
  businessId    String
  partyId       String
  invoiceNo     String
  docType       InvoiceDocType @default(INVOICE)
  status        InvoiceStatus  @default(UNPAID)
  convertedToId String?        @unique
  issueDate  DateTime      @default(now())
  dueDate    DateTime?
  subtotal   Decimal       @db.Decimal(12, 2)
  taxAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  notes      String?       @db.Text
  stockDeducted Boolean    @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party          Party         @relation(fields: [partyId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  convertedTo    Invoice?      @relation("ProformaConversion", fields: [convertedToId], references: [id])
  proformaSource Invoice?      @relation("ProformaConversion")

  @@unique([businessId, invoiceNo])
  @@index([businessId, docType, status])
  @@index([partyId])
  @@index([businessId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  itemId    String?
  name      String
  qty       Decimal @db.Decimal(12, 3)
  price     Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  amount    Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String      @id @default(cuid())
  invoiceId String
  amount    Decimal     @db.Decimal(12, 2)
  mode      PaymentMode @default(CASH)
  note      String?
  paidAt    DateTime    @default(now())
  createdAt DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────── Reminders & notifications ───────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model Reminder {
  id         String          @id @default(cuid())
  businessId String
  partyId    String
  message    String?         @db.Text
  dueDate    DateTime
  status     ReminderStatus  @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([businessId, status, dueDate])
  @@map("reminders")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String    @db.Text
  type      String    @default("GENERAL")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────── Activity log ───────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("activity_logs")
}
