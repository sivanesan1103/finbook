# ─────────────────────────────────────────────────────────────────────────
# FinBook production environment — AWS server (100.99.22.48).
#
# Copy this to `.env` NEXT TO docker-compose.prod.yml on the server, then fill
# in real values. NEVER commit the real .env. Generate each secret ON THE BOX:
#     openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-56
# ─────────────────────────────────────────────────────────────────────────

# ── Database ──
MYSQL_DATABASE=finbook
MYSQL_USER=finbook
MYSQL_PASSWORD=CHANGE_ME_db_app_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_db_root_password

# ── API auth secrets (the boot-guard refuses to start if these are missing
#    or a known placeholder) ──
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl
SHARE_TOKEN_SECRET=CHANGE_ME_generate_with_openssl
FILE_URL_SECRET=CHANGE_ME_generate_with_openssl

# ── Public URLs / CORS (the new domain) ──
PUBLIC_WEB_URL=https://finbook.online
CORS_ORIGINS=https://finbook.online
GRAFANA_ROOT_URL=https://grafana.finbook.online

# ── Backup tool (restore UI login) ──
BACKUP_TOOL_USER=admin
BACKUP_TOOL_PASS=CHANGE_ME_backup_ui_password

# ── Grafana admin ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ── Cloudflare Tunnel token (from the Cloudflare dashboard) ──
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_cloudflare_tunnel_token

# ── Optional integrations (leave blank to disable) ──
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
